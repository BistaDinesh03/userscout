# ── UserScout environment ─────────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored — never commit it.

# Optional GitHub personal access token (classic or fine-grained).
# NO special scopes are needed — it is only used for public read endpoints,
# but it raises rate limits from 60→5,000 core requests/h and 10→30 search/min.
# Sent only to https://api.github.com. Never logged.
VITE_GITHUB_TOKEN=
